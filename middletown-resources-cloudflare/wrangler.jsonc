{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "middletownwebsite",
  "main": "worker.js",
  "compatibility_date": "2026-08-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDFS"
    }
  ]
}
